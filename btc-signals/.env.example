# ============================================================================
# NEVER commit this file (it is in .gitignore). NEVER paste these values anywhere.
# ============================================================================

# LIVE auto-trading on POLYMARKET US (venue: polymarket_us). Paper mode needs none of this.
# Create the key at https://polymarket.us/developer after your account passes verification.
# The secret is shown ONCE - paste it here, nowhere else.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# LIVE auto-trading on polymarket.com (venue: polymarket_intl; not available in the US).
# Use a SEPARATE wallet funded only with money you can afford to lose.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=

# Optional: Polymarket CLOB API credentials. Only needed for the PolyBolt price
# feed (replacement for the deprecated RTDS feed). Read-only use; the app never trades.
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Phone alerts via ntfy (free, no account): install the ntfy app, subscribe to a long,
# hard-to-guess topic name, and put the same name here. Anyone who knows the name can read it.
NTFY_TOPIC=
# Optional, only for a protected/self-hosted ntfy server:
NTFY_TOKEN=

# Or phone alerts via Telegram: create a bot with @BotFather, message it once,
# then get your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sports module odds (free tiers; optional - without them the sports board shows prices only)
THERUNDOWN_API_KEY=      # https://therundown.io/api  (free: DraftKings, FanDuel, BetMGM)
SHARPAPI_KEY=            # https://sharpapi.io        (free: DraftKings, FanDuel, 60s delay)
THE_ODDS_API_KEY=        # https://the-odds-api.com   (free 500 credits/month: Pinnacle checks)
